{
    "manufacturer": "Ryan Le",
    "keyboard_name": "Macropad9",
    "maintainer": "Ryan-Le-512",
    "url": "https://github.com/Ryan-Le-512",
    "usb": {
        "vid": "0xFEED",
        "pid": "0x0009",
        "device_version": "1.0.0"
    },
    "processor": "atmega32u4",
    "bootloader": "caterina",
    "debounce": 5,
    "diode_direction": "COL2ROW",
    "matrix_pins": {
        "cols": ["B5", "B6", "D4", "B4"],
        "rows": ["C6", "D7", "E6"]
    },
    "encoder": {
        "rotary": [
            { "pin_a": "F6", "pin_b": "F7", "resolution": 4 }
        ]
    },
    "features": {
        "bootmagic": true,
        "encoder": true,
        "extrakey": true,
        "mousekey": false,
        "console": false,
        "command": false,
        "nkro": false,
        "backlight": false,
        "rgblight": false,
        "audio": false
    },
    "layouts": {
        "LAYOUT": {
            "layout": [
                {"matrix": [0, 0], "x": 0, "y": 0},
                {"matrix": [0, 1], "x": 1, "y": 0},
                {"matrix": [0, 2], "x": 2, "y": 0},

                {"matrix": [1, 0], "x": 0, "y": 1},
                {"matrix": [1, 1], "x": 1, "y": 1},
                {"matrix": [1, 2], "x": 2, "y": 1},

                {"matrix": [2, 0], "x": 0, "y": 2},
                {"matrix": [2, 1], "x": 1, "y": 2},
                {"matrix": [2, 2], "x": 2, "y": 2},

                {"matrix": [2, 3], "x": 3.5, "y": 2}
            ]
        }
    }
}
